{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "rangeStrategy": "replace",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": ["security"]
  },
  "pip_requirements": {
    "managerFilePatterns": ["/(^|/)constraints-ci\\.txt$/"]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "pytest",
        "pytest-asyncio",
        "pytest-cov",
        "build",
        "ruff"
      ],
      "groupName": "python dev dependencies"
    },
    {
      "matchFileNames": ["constraints-ci.txt"],
      "matchPackageNames": ["aiohttp", "aiointercept"],
      "groupName": "CI HTTP test stack"
    },
    {
      "matchFileNames": ["pyproject.toml"],
      "matchPackageNames": ["aiohttp", "aiointercept"],
      "enabled": false
    },
    {
      "matchFileNames": ["constraints-ci-lowest.txt"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
